@{
    ViewData["Title"] = "Авторизація";
}

<div class="flex items-center justify-center min-h-[70vh]">
    <div class="bg-white p-8 rounded-xl shadow-md border border-gray-100 w-full max-w-md">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-12 h-12 bg-blue-100 text-blue-600 rounded-full mb-4">
                <i class="bi bi-box-arrow-in-right text-2xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">З поверненням!</h1>
            <p class="text-gray-500 text-sm mt-2">Увійдіть до свого облікового запису PetCare</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-5">
            <div>
                <label class="block font-semibold text-gray-700 mb-1 text-sm">Email</label>
                <input type="email" name="Email" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="pet@care.com" />
            </div>
            
            <div>
                <label class="block font-semibold text-gray-700 mb-1 text-sm">Пароль</label>
                <input type="password" name="Password" required class="w-full border border-gray-300 p-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="••••••••" />
            </div>
            
            <div class="flex items-center justify-between text-sm">
                <label class="flex items-center text-gray-600 cursor-pointer">
                    <input type="checkbox" name="RememberMe" class="mr-2 w-4 h-4 text-blue-600 rounded focus:ring-blue-500 border-gray-300" />
                    Запам'ятати мене
                </label>
                <a href="#" class="text-blue-600 hover:underline">Забули пароль?</a>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition shadow-sm mt-2">
                Увійти
            </button>
        </form>

        <div class="mt-6 text-center text-sm text-gray-600 border-t pt-4">
            Ще немає акаунта? 
            <a asp-controller="Account" asp-action="Register" class="text-blue-600 hover:underline font-semibold">Зареєструватися</a>
        </div>
    </div>
</div>
<!-- Модальне вікно: ДОДАВАННЯ (завдання 3 - Введення з клавіатури) -->
<div id="addModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-xl shadow-lg w-11/12 max-w-2xl p-6 relative">
        <button onclick="closeModals()" class="absolute top-4 right-4 text-gray-500 hover:text-red-500 z-10"><i class="bi bi-x-circle-fill text-2xl"></i></button>
        <h2 class="text-2xl font-bold mb-4">Додати нову тварину</h2>
        
        <!-- Вбудований компонент, розроблений тестувальником -->
        <partial name="_CreatePetComponent" />
        
    </div>
</div>
<script>
    // Відображення вікна ПЕРЕГЛЯДУ
    function openViewModal(name, img, age, diet, allergies, diseases, generalInfo) {
        document.getElementById('viewName').innerText = name;
        document.getElementById('viewImg').src = img;
        document.getElementById('viewAge').innerText = age;
        document.getElementById('viewDiet').innerText = diet;
        document.getElementById('viewAllergies').innerText = allergies;
        document.getElementById('viewDiseases').innerText = diseases;
        document.getElementById('viewGeneralInfo').innerText = generalInfo;
        
        document.getElementById('viewModal').classList.remove('hidden');
        document.getElementById('viewModal').classList.add('flex');
    }

    // Закриття всіх модалок
    function closeModals() {
        document.getElementById('viewModal').classList.add('hidden');
        document.getElementById('addModal').classList.add('hidden');
    }

    // Підключення кнопок з Шапки (_Layout.cshtml)
    document.addEventListener("DOMContentLoaded", () => {
        // Кнопка "Додати"
        const btnAdd = document.getElementById('btnOpenAddModal');
        if (btnAdd) {
            btnAdd.addEventListener('click', () => {
                document.getElementById('addModal').classList.remove('hidden');
                document.getElementById('addModal').classList.add('flex');
            });
        }

        // Кнопка "Видалити" (Вмикає/вимикає червоні хрестики на картках)
        const btnDelete = document.getElementById('btnToggleDelete');
        if (btnDelete) {
            btnDelete.addEventListener('click', () => {
                document.querySelectorAll('.delete-form').forEach(form => {
                    form.classList.toggle('hidden');
                });
                btnDelete.classList.toggle('bg-red-800'); // Зміна кольору кнопки при активному режимі
            });
        }
    });
</script>